# Запускает именованный экземпляр OpenVPN лаборатории.
[Unit]
Description=OTUS OpenVPN instance %i
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/sbin/openvpn --config /etc/openvpn/otus/%i.conf
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target

# Версия 1 | 2026-11-09 | Служба для TUN, TAP и RAS.
