# Сервер удалённого доступа с обязательным сертификатом клиента.
port 1194
proto udp4
dev tunras
dev-type tun
topology subnet
server 10.79.0.0 255.255.255.0
ca /etc/openvpn/otus/pki/ca.crt
cert /etc/openvpn/otus/pki/issued/ras-server.crt
key /etc/openvpn/otus/pki/private/ras-server.key
dh none
tls-crypt /etc/openvpn/otus/ras-tls.key
verify-client-cert require
remote-cert-tls client
tls-version-min 1.2
keepalive 10 60
persist-key
persist-tun
verb 3

# Версия 1 | 2026-11-09 | TLS RAS с Easy-RSA и отдельной подсетью.
